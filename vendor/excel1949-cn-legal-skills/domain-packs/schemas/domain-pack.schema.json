{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/domain-pack.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "pack_name",
    "title",
    "author",
    "status",
    "verified_on",
    "scope",
    "consumers",
    "authorities",
    "issue_families",
    "global_prohibitions",
    "update_triggers",
    "test_scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "pack_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "author": {
      "const": "AIOffice职场通关-excel1949"
    },
    "status": {
      "enum": [
        "testing",
        "stable",
        "deprecated"
      ]
    },
    "verified_on": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "required": [
        "included",
        "excluded"
      ],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "authority_id",
          "title",
          "authority_type",
          "effect_status",
          "verified_on",
          "source_url",
          "check_before_use"
        ],
        "properties": {
          "authority_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
          },
          "title": {
            "type": "string"
          },
          "authority_type": {
            "enum": [
              "law",
              "administrative_regulation",
              "department_rule",
              "judicial_interpretation",
              "official_guidance"
            ]
          },
          "effect_status": {
            "enum": [
              "effective_at_verification",
              "not_yet_effective",
              "unknown"
            ]
          },
          "verified_on": {
            "type": "string",
            "format": "date"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "check_before_use": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    },
    "issue_families": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "issue_key",
          "label",
          "questions",
          "fact_fields",
          "evidence_prompts",
          "calculation_hooks",
          "deadline_hooks",
          "prohibitions"
        ],
        "properties": {
          "issue_key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "label": {
            "type": "string"
          },
          "questions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "fact_fields": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "evidence_prompts": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "calculation_hooks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deadline_hooks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prohibitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "global_prohibitions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "update_triggers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "test_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "prompt",
          "expected_questions",
          "forbidden_inferences"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
          },
          "prompt": {
            "type": "string"
          },
          "expected_questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "forbidden_inferences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "title_zh": {
      "type": "string",
      "description": "中文标题（英文 title 的中文对照）"
    }
  },
  "additionalProperties": false
}
