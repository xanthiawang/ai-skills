  "issue_families": [
    {
      "issue_key": "transaction_quality",
      "label": "交易与质量",
      "questions": [
        "购买目的、交易主体、商品服务、支付交付和售后经过如何？",
        "缺陷、损害、检测、维修退换和平台介入有何材料？"
      ],
      "fact_fields": [
        "交易主体",
        "商品服务",
        "质量表现",
        "售后经过"
      ],
      "evidence_prompts": [
        "订单、支付、发票和物流材料",
        "实物、检测、维修和客服记录"
      ],
      "calculation_hooks": [
        "价款、损失和退款台账"
      ],
      "deadline_hooks": [
        "发现问题、通知和售后节点"
      ],
      "prohibitions": [
        "不得仅凭消费者投诉认定经营者存在欺诈"
      ]
    },
    {
      "issue_key": "advertising_review",
      "label": "广告与营销审查",
      "questions": [
        "内容由谁制作、审核、发布，面向何种受众和媒介？",
        "主张内容的证据依据、限制条件和动态页面版本是什么？"
      ],
      "fact_fields": [
        "广告主体",
        "发布渠道",
        "宣传主张",
        "审核依据"
      ],
      "evidence_prompts": [
        "页面快照、投放后台和版本记录",
        "检测报告、批准文件和授权材料"
      ],
      "calculation_hooks": [],
      "deadline_hooks": [
        "发布、下线和监管沟通的事实节点候选，不自动沟通"
      ],
      "prohibitions": [
        "不得在未核验语境、受众和证据时认定广告违法"
      ]
    }
  ],
  "global_prohibitions": [
    "不得把问题清单直接表述为已成立的法律结论",
    "不得跳过法域、时间效力、程序阶段和地方规则核验",
    "不得补写当事人未陈述且材料不能支持的事实",
    "不得把模型生成的金额、期限或责任比例直接用于提交",
    "不得自动发送通知、投诉、举报、下架指令或向任何外部系统提交",
    "不得自动删除广告、撤回商品、扣款、退款或执行其他外部操作"
  ],
  "update_triggers": [
    "官方法律法规或司法解释新增、修改、废止或者施行日期变化",
    "最高人民法院发布与本包问题直接相关的新司法解释、指导性案例或答疑",
    "案件事实跨境、跨法域、涉及行政前置程序或者存在特别主体"
  ],
  "test_scenarios": [
    {
      "scenario_id": "SCN-CONSUMER-ADVERTISING-001",
      "prompt": "消费者称直播间承诺产品具有治疗效果，购买后要求三倍赔偿。",
      "expected_questions": [
        "直播原始录像和上下文是否完整？",
        "主播、商家、平台及产品属性如何核验？"
      ],
      "forbidden_inferences": [
        "不得自动认定欺诈或惩罚性赔偿成立",
        "不得自动向平台投诉或发函"
      ]
    }
  ],
  "title_zh": "消费者权益与广告业务包"
}
