{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-evidence-map/evidence-map-output.schema.json",
  "type": "object",
  "required": [
    "schema_version", "map_id", "matter_id", "cutoff_date", "matrix", "gaps",
    "potential_conflicts", "coverage", "artifact_state", "legal_notice"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "map_id": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"},
    "matter_id": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"},
    "cutoff_date": {"type": "string", "format": "date"},
    "matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id", "name", "source_id", "source_file", "source_sha256",
          "fact_ids", "issue_ids", "position_ids", "proof_purposes",
          "three_nature", "verification_status", "source_locations"
        ],
        "properties": {
          "evidence_id": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"},
          "name": {"type": "string", "minLength": 1},
          "source_id": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"},
          "source_file": {"type": "string", "minLength": 1},
          "source_sha256": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/sha256"},
          "fact_ids": {"type": "array", "items": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"}},
          "issue_ids": {"type": "array", "items": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"}},
          "position_ids": {"type": "array", "items": {"type": "string", "pattern": "^(claim|defense):"}},
          "proof_purposes": {"type": "array", "items": {"type": "object"}},
          "three_nature": {
            "type": "object",
            "required": ["authenticity", "legality", "relevance"],
            "properties": {
              "authenticity": {"enum": ["unreviewed", "accepted", "disputed", "unknown"]},
              "legality": {"enum": ["unreviewed", "accepted", "disputed", "unknown"]},
              "relevance": {"enum": ["unreviewed", "accepted", "disputed", "unknown"]}
            },
            "additionalProperties": false
          },
          "verification_status": {"enum": ["pending", "machine_checked", "human_checked"]},
          "source_locations": {"type": "array", "items": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/source_span"}}
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_type", "target_id"],
        "properties": {
          "gap_type": {
            "enum": [
              "fact_without_evidence", "issue_without_fact", "issue_without_evidence",
              "position_without_fact", "position_without_evidence",
              "proof_purpose_unconfirmed", "three_nature_unreviewed"
            ]
          },
          "target_id": {"type": "string", "minLength": 1},
          "dimensions": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["authenticity", "legality", "relevance"]}
          }
        },
        "additionalProperties": false
      }
    },
    "potential_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "kind", "fact_ids", "reason", "status", "source_spans"],
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["declared", "status_flag", "same_field_different_value"]},
          "fact_ids": {"type": "array", "minItems": 1, "items": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"}},
          "reason": {"type": "string", "minLength": 1},
          "status": {"enum": ["declared", "human_confirmed", "resolved", "candidate"]},
          "source_spans": {"type": "array", "items": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/source_span"}}
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "evidence_count", "fact_count", "facts_with_evidence", "issue_count",
        "issues_with_evidence", "position_count", "positions_with_evidence"
      ],
      "properties": {
        "evidence_count": {"type": "integer", "minimum": 0},
        "fact_count": {"type": "integer", "minimum": 0},
        "facts_with_evidence": {"type": "integer", "minimum": 0},
        "issue_count": {"type": "integer", "minimum": 0},
        "issues_with_evidence": {"type": "integer", "minimum": 0},
        "position_count": {"type": "integer", "minimum": 0},
        "positions_with_evidence": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "artifact_state": {"const": "lawyer_review_required"},
    "legal_notice": {"type": "string", "minLength": 1}
  }
}
