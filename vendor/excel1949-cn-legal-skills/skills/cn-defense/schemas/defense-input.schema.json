{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-defense/defense-input.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "draft_id", "matter_id", "as_of_date", "case_analysis", "evidence_map", "research_report", "complaint", "defense_request", "declared_conflicts"],
  "properties": {
    "schema_version": {"const": "1.0"}, "draft_id": {"$ref": "#/$defs/id"}, "matter_id": {"$ref": "#/$defs/id"}, "as_of_date": {"type": "string", "format": "date"},
    "case_analysis": {"type": "object", "additionalProperties": true, "required": ["matter_id", "pending_confirmations"], "properties": {"matter_id": {"$ref": "#/$defs/id"}, "pending_confirmations": {"type": "array", "items": {"type": "object"}}}},
    "evidence_map": {"type": "object", "additionalProperties": true, "required": ["matter_id", "matrix", "gaps", "potential_conflicts", "artifact_state"], "properties": {"matter_id": {"$ref": "#/$defs/id"}, "matrix": {"type": "array", "items": {"type": "object"}}, "gaps": {"type": "array", "items": {"type": "object"}}, "potential_conflicts": {"type": "array", "items": {"type": "object"}}, "artifact_state": {"const": "lawyer_review_required"}}},
    "research_report": {"type": "object", "additionalProperties": false, "required": ["schema_version", "report_id", "task", "records", "state"], "properties": {"schema_version": {"const": "1.0"}, "report_id": {"$ref": "#/$defs/id"}, "task": {"type": "object", "additionalProperties": true, "required": ["matter_id"], "properties": {"matter_id": {"$ref": "#/$defs/id"}}}, "records": {"type": "array", "items": {"$ref": "#/$defs/authority"}}, "state": {"enum": ["machine_checked", "lawyer_review_required", "lawyer_reviewed"]}}},
    "complaint": {"type": "object", "additionalProperties": false, "required": ["claims"], "properties": {"claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/complaint_claim"}}}},
    "defense_request": {"type": "object", "additionalProperties": false, "required": ["respondent", "responses", "defensive_facts", "independent_defenses"], "properties": {
      "respondent": {"$ref": "#/$defs/sourced_text"},
      "responses": {"type": "array", "items": {"$ref": "#/$defs/response"}},
      "defensive_facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
      "independent_defenses": {"type": "array", "items": {"$ref": "#/$defs/independent_defense"}}
    }},
    "declared_conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "span": {"type": "object", "additionalProperties": false, "required": ["source_id", "locator", "quote"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "locator": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}}},
    "provenance": {"anyOf": [{"required": ["source_spans"], "properties": {"source_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}}}, {"required": ["user_confirmed", "confirmation_note"], "properties": {"user_confirmed": {"const": true}, "confirmation_note": {"type": "string", "minLength": 1}}}]},
    "sourced_text": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1}, "source_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}, "user_confirmed": {"type": "boolean"}, "confirmation_note": {"type": "string"}}, "allOf": [{"$ref": "#/$defs/provenance"}]},
    "complaint_claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "text_verbatim"], "properties": {"claim_id": {"$ref": "#/$defs/id"}, "text_verbatim": {"type": "string", "minLength": 1}, "source_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}, "user_confirmed": {"type": "boolean"}, "confirmation_note": {"type": "string"}}, "allOf": [{"$ref": "#/$defs/provenance"}]},
    "response": {"type": "object", "additionalProperties": false, "required": ["response_id", "claim_id", "stance", "response_text", "fact_ids", "evidence_ids", "authority_ids"], "properties": {"response_id": {"$ref": "#/$defs/id"}, "claim_id": {"$ref": "#/$defs/id"}, "stance": {"enum": ["admit", "deny", "lack_knowledge", "procedural_objection"]}, "response_text": {"type": "string", "minLength": 1}, "fact_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "authority_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "source_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}, "user_confirmed": {"type": "boolean"}, "confirmation_note": {"type": "string"}}, "allOf": [{"$ref": "#/$defs/provenance"}]},
    "fact": {"type": "object", "additionalProperties": false, "required": ["fact_id", "text", "evidence_ids"], "properties": {"fact_id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "source_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}, "user_confirmed": {"type": "boolean"}, "confirmation_note": {"type": "string"}}, "allOf": [{"$ref": "#/$defs/provenance"}]},
    "independent_defense": {"type": "object", "additionalProperties": false, "required": ["defense_id", "category", "text", "fact_ids", "evidence_ids", "authority_ids"], "properties": {"defense_id": {"$ref": "#/$defs/id"}, "category": {"enum": ["substantive", "procedural", "evidentiary", "reservation"]}, "text": {"type": "string", "minLength": 1}, "fact_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "authority_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "source_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}, "user_confirmed": {"type": "boolean"}, "confirmation_note": {"type": "string"}}, "allOf": [{"$ref": "#/$defs/provenance"}]},
    "authority": {"type": "object", "additionalProperties": true, "required": ["record_id", "verification_status", "full_text_checked", "effect_status"], "properties": {"record_id": {"$ref": "#/$defs/id"}, "verification_status": {"enum": ["pending", "source_opened", "verified", "failed"]}, "full_text_checked": {"type": "boolean"}, "effect_status": {"enum": ["effective", "amended", "repealed", "not_yet_effective", "not_applicable", "unknown"]}}},
    "conflict": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "description", "status", "source_spans"], "properties": {"conflict_id": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1}, "status": {"enum": ["declared", "human_confirmed", "resolved"]}, "source_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}}}
  }
}
