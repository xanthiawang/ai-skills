{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-appeal/appeal-input.schema.json",
  "title": "上诉审查输入",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matter_id", "appeal_id", "case_type", "sources", "authorities", "judgment", "appeal_requests", "review_issues", "deadline_review", "evidence", "new_evidence_explanations", "external_action_requested"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matter_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "appeal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "case_type": {"enum": ["civil", "administrative", "criminal", "other", "unknown"]},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "authorities": {"type": "array", "items": {"$ref": "#/$defs/authority"}},
    "judgment": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "operative_part", "reasoning", "issues"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "operative_part": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cited_statement"}},
        "reasoning": {"type": "array", "items": {"$ref": "#/$defs/cited_statement"}},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/cited_statement"}}
      }
    },
    "appeal_requests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/request"}},
    "review_issues": {"type": "array", "items": {"$ref": "#/$defs/review_issue"}},
    "deadline_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "rule_inputs", "service_facts", "lawyer_conclusion"],
      "properties": {
        "status": {"enum": ["unverified", "verified_by_lawyer"]},
        "rule_inputs": {"type": "array", "items": {"$ref": "#/$defs/rule_input"}},
        "service_facts": {"type": "array", "items": {"$ref": "#/$defs/cited_statement"}},
        "lawyer_conclusion": {"type": ["string", "null"]}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "new_evidence_explanations": {"type": "array", "items": {"$ref": "#/$defs/new_evidence"}},
    "external_action_requested": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "file_name", "sha256"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "file_name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_id", "title", "official_url", "verified_on", "effect_status"],
      "properties": {
        "authority_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1},
        "official_url": {"type": "string", "format": "uri"}, "verified_on": {"type": "string", "format": "date"},
        "effect_status": {"enum": ["effective", "partly_effective", "unknown"]}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {"source_id": {"$ref": "#/$defs/id"}, "locator": {"type": "string", "minLength": 1}}
    },
    "cited_statement": {
      "type": "object", "additionalProperties": false,
      "required": ["statement_id", "text", "citation"],
      "properties": {"statement_id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1}, "citation": {"$ref": "#/$defs/citation"}}
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "verbatim_text", "basis"],
      "properties": {
        "request_id": {"$ref": "#/$defs/id"}, "verbatim_text": {"type": "string", "minLength": 1},
        "basis": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["basis_type", "source_id", "locator"], "properties": {"basis_type": {"const": "source_span"}, "source_id": {"$ref": "#/$defs/id"}, "locator": {"type": "string", "minLength": 1}}},
            {"type": "object", "additionalProperties": false, "required": ["basis_type", "confirmed_at", "confirmation_note"], "properties": {"basis_type": {"const": "user_confirmed"}, "confirmed_at": {"type": "string", "format": "date-time"}, "confirmation_note": {"type": "string", "minLength": 1}}}
          ]
        }
      }
    },
    "review_issue": {
      "type": "object", "additionalProperties": false,
      "required": ["issue_id", "issue_type", "question", "supporting_citations", "opposing_citations"],
      "properties": {
        "issue_id": {"$ref": "#/$defs/id"}, "issue_type": {"enum": ["fact_dispute", "legal_application", "procedural_issue"]},
        "question": {"type": "string", "minLength": 1},
        "supporting_citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "opposing_citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}}
      }
    },
    "rule_input": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "authority_id", "locator", "rule_text"],
      "properties": {"rule_id": {"$ref": "#/$defs/id"}, "authority_id": {"$ref": "#/$defs/id"}, "locator": {"type": "string", "minLength": 1}, "rule_text": {"type": "string", "minLength": 1}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "name", "citation", "purpose", "review_status"],
      "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "citation": {"$ref": "#/$defs/citation"}, "purpose": {"type": "string", "minLength": 1}, "review_status": {"enum": ["unreviewed", "lawyer_reviewed"]}}
    },
    "new_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "claimed_as_new", "not_submitted_reason", "purpose", "explanation_basis"],
      "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "claimed_as_new": {"type": "boolean"}, "not_submitted_reason": {"type": ["string", "null"]}, "purpose": {"type": "string", "minLength": 1}, "explanation_basis": {"$ref": "#/$defs/citation"}}
    }
  }
}
