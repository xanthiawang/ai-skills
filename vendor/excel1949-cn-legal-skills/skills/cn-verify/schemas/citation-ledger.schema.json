{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-verify/citation-ledger.schema.json",
  "type": "object",
  "required": ["schema_version", "matter_id", "audit_id", "as_of", "artifact", "authorities", "citations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matter_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "audit_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "as_of": {"type": "string", "format": "date-time"},
    "artifact": {
      "type": "object",
      "required": ["title", "text", "text_sha256"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["authority_id", "title", "authority_type", "effect_status", "verification_status", "source_url", "verified_at"],
        "properties": {
          "authority_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
          "title": {"type": "string", "minLength": 1},
          "authority_type": {"enum": ["law", "administrative_regulation", "judicial_interpretation", "normative_document", "guiding_case", "case_library", "gazette_case", "judgment", "official_document", "other_primary_source"]},
          "effect_status": {"enum": ["effective", "amended", "repealed", "not_yet_effective", "unknown"]},
          "verification_status": {"enum": ["verified_fulltext", "pending"]},
          "source_url": {"type": "string", "minLength": 1},
          "verified_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["citation_id", "mode", "document_span", "authority_refs", "human_review_status"],
        "properties": {
          "citation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
          "mode": {"enum": ["exact_quote", "paraphrase", "reference_only"]},
          "document_span": {
            "type": "object",
            "required": ["start", "end", "text"],
            "properties": {
              "start": {"type": "integer", "minimum": 0},
              "end": {"type": "integer", "minimum": 1},
              "text": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "quoted_text": {"type": "string", "minLength": 1},
          "authority_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["authority_id", "locator", "source_excerpt"],
              "properties": {
                "authority_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
                "locator": {"type": "string", "minLength": 1},
                "source_excerpt": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "human_review_status": {"enum": ["pending", "confirmed"]}
        },
        "allOf": [
          {
            "if": {"properties": {"mode": {"const": "exact_quote"}}, "required": ["mode"]},
            "then": {"required": ["quoted_text"]}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
