{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-verify/review-report.schema.json",
  "type": "object",
  "required": ["schema_version", "report_id", "matter_id", "artifact_id", "mode", "request_sha256", "input_sha256", "text_sha256", "generated_at", "state", "summary", "checked_categories", "findings", "limitations", "disclaimers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"},
    "matter_id": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"},
    "artifact_id": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"},
    "mode": {"enum": ["production", "training_fixture"]},
    "request_sha256": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/sha256"},
    "input_sha256": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/sha256"},
    "text_sha256": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["blocked", "lawyer_review_required", "machine_checked"]},
    "summary": {
      "type": "object",
      "required": ["blocker", "warning", "note", "total"],
      "properties": {
        "blocker": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "note": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "checked_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["fact", "evidence", "authority", "number", "date", "citation", "consistency", "privacy", "confirmation", "scope"]}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "category", "code", "message", "location", "evidence", "action", "human_confirmation_required"],
        "properties": {
          "finding_id": {"$ref": "https://aioffice.example/schemas/cn-legal-core/common.schema.json#/$defs/stable_id"},
          "severity": {"enum": ["blocker", "warning", "note"]},
          "category": {"enum": ["fact", "evidence", "authority", "number", "date", "citation", "consistency", "privacy", "confirmation", "scope"]},
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.-]+$"},
          "message": {"type": "string", "minLength": 1},
          "location": {"type": "string"},
          "evidence": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "action": {"type": "string", "minLength": 1},
          "human_confirmation_required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "disclaimers": {
      "const": [
        "AI 生成的法律文书仅供学习参考，不得直接用于提交法院或对方当事人。",
        "使用 AI 生成文书前，必须由专业执业律师人工核验事实与法律适用。",
        "AI 不能替代律师对案件具体情况进行独立法律判断。",
        "本课程 AI 仅用于辅助写法律文书，最终法律文书须经专业律师逐案审查与确认。",
        "AI 生成文书质量高低，起决定性因素的是使用者自身法律水平的高低。"
      ]
    }
  },
  "additionalProperties": false
}
