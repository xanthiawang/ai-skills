{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-legal-core/calculation.schema.json",
  "type": "object",
  "required": ["calculation_id", "formula", "inputs", "steps", "output", "status"],
  "properties": {
    "calculation_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "formula": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "rounding_rule": {"type": "string"},
    "output": {},
    "status": {"enum": ["draft", "machine_checked", "human_confirmed", "blocked"]}
  },
  "additionalProperties": false
}

