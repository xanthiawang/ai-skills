{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-legal-core/party.schema.json",
  "type": "object",
  "required": ["party_id", "entity_type", "procedural_roles", "name_status"],
  "properties": {
    "party_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "entity_type": {"enum": ["natural_person", "legal_person", "unincorporated_organization", "state_authority", "unknown"]},
    "procedural_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "name": {"type": "string"},
    "name_status": {"$ref": "common.schema.json#/$defs/fact_status"},
    "source_spans": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/source_span"}}
  },
  "additionalProperties": false
}

