{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-legal-core/fact-ledger.schema.json",
  "type": "object",
  "required": ["fact_id", "status", "raw_value", "source_spans"],
  "properties": {
    "fact_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "field": {"type": "string"},
    "raw_value": {},
    "normalized_value": {},
    "status": {"$ref": "common.schema.json#/$defs/fact_status"},
    "source_spans": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/source_span"}},
    "confirmed_at": {"type": "string", "format": "date-time"},
    "derivation_rule": {"type": "string"}
  },
  "additionalProperties": false
}

