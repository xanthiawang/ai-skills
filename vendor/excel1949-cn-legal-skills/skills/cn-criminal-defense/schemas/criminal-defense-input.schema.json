{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-criminal-defense/input.schema.json",
  "title": "中国刑事辩护工作台输入",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matter_id", "as_of_date", "stage", "official_documents", "accusations", "authorities", "deadline_rules", "element_candidates", "evidence_reviews", "exclusion_clues", "liberty_and_meeting_tasks", "sentencing_candidates", "defense_positions", "requested_actions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matter_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "as_of_date": {"type": "string", "format": "date"},
    "stage": {"enum": ["investigation", "review_prosecution", "trial", "unknown"]},
    "official_documents": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["document_id", "title", "issuing_authority", "document_date", "source_file"],
        "properties": {
          "document_id": {"type": "string", "pattern": "^DOC-[A-Za-z0-9._-]+$"},
          "title": {"type": "string", "minLength": 1},
          "issuing_authority": {"type": "string", "minLength": 1},
          "document_date": {"type": ["string", "null"], "format": "date"},
          "source_file": {"type": "string", "minLength": 1}
        }
      }
    },
    "accusations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["accusation_id", "kind", "text_verbatim", "source_document_ids", "recording_mode"],
        "properties": {
          "accusation_id": {"type": "string", "pattern": "^ACC-[A-Za-z0-9._-]+$"},
          "kind": {"enum": ["alleged_fact", "alleged_offense"]},
          "text_verbatim": {"type": "string", "minLength": 1},
          "source_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "recording_mode": {"const": "verbatim_from_official_document"}
        }
      }
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["authority_id", "title", "source_url", "verified_at", "effect_status"],
        "properties": {
          "authority_id": {"type": "string", "pattern": "^AUTH-[A-Za-z0-9._-]+$"},
          "title": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "verified_at": {"type": "string", "format": "date"},
          "effect_status": {"enum": ["effective", "amended", "repealed", "unknown"]}
        }
      }
    },
    "deadline_rules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "name", "rule_text_verbatim", "start_event", "candidate_due_date", "authority_ids", "liberty_related"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^RULE-[A-Za-z0-9._-]+$"},
          "name": {"type": "string", "minLength": 1},
          "rule_text_verbatim": {"type": "string", "minLength": 1},
          "start_event": {"type": ["string", "null"]},
          "candidate_due_date": {"type": ["string", "null"], "format": "date"},
          "authority_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "liberty_related": {"type": "boolean"}
        }
      }
    },
    "element_candidates": {"$ref": "#/$defs/candidates"},
    "sentencing_candidates": {"$ref": "#/$defs/candidates"},
    "defense_positions": {"$ref": "#/$defs/candidates"},
    "evidence_reviews": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "name", "source_document_ids", "authenticity", "legality", "relevance", "notes"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^EVID-[A-Za-z0-9._-]+$"},
          "name": {"type": "string", "minLength": 1},
          "source_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "authenticity": {"enum": ["unreviewed", "supported", "disputed", "unknown"]},
          "legality": {"enum": ["unreviewed", "supported", "disputed", "unknown"]},
          "relevance": {"enum": ["unreviewed", "supported", "disputed", "unknown"]},
          "notes": {"type": "string"}
        }
      }
    },
    "exclusion_clues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["clue_id", "description", "evidence_ids", "source_document_ids", "status"],
        "properties": {
          "clue_id": {"type": "string", "pattern": "^CLUE-[A-Za-z0-9._-]+$"},
          "description": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "source_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "status": {"enum": ["candidate", "investigation_required", "lawyer_reviewed"]}
        }
      }
    },
    "liberty_and_meeting_tasks": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "task_type", "description", "liberty_status", "deadline_rule_ids", "status"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^TASK-[A-Za-z0-9._-]+$"},
          "task_type": {"enum": ["custody", "meeting", "document_request", "deadline_check", "other"]},
          "description": {"type": "string", "minLength": 1},
          "liberty_status": {"enum": ["not_restricted", "possibly_restricted", "detained", "arrested", "residential_surveillance", "restricted_other", "unknown"]},
          "deadline_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "status": {"enum": ["open", "in_progress", "completed", "blocked"]}
        }
      }
    },
    "requested_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_id", "statement", "source_document_ids", "evidence_ids", "authority_ids", "status"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^CAND-[A-Za-z0-9._-]+$"},
          "statement": {"type": "string", "minLength": 1},
          "source_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "authority_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "status": {"enum": ["candidate", "research_required", "lawyer_reviewed"]}
        }
      }
    }
  }
}
