{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-deadline/deadline-input.schema.json",
  "type": "object",
  "required": ["schema_version", "matter_id", "as_of_date", "calendars", "deadlines"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matter_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "as_of_date": {"type": "string", "format": "date"},
    "calendars": {
      "type": "array",
      "items": {"$ref": "#/$defs/calendar"}
    },
    "deadlines": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/deadline"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "authority_type", "title", "document_locator", "quote", "effect_status", "verified_on"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
        "authority_type": {"enum": ["law", "judicial_interpretation", "court_document", "arbitration_rules", "contract", "internal_policy", "official_calendar", "other"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "document_locator": {"type": "string", "minLength": 1, "maxLength": 1000},
        "quote": {"type": "string", "minLength": 1, "maxLength": 5000},
        "effect_status": {"enum": ["effective", "not_yet_effective", "repealed", "superseded", "unknown"]},
        "verified_on": {"type": "string", "format": "date"},
        "url": {"type": "string", "format": "uri"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "calendar": {
      "type": "object",
      "required": ["calendar_id", "timezone", "coverage_start", "coverage_end", "declared_complete", "weekend_weekdays", "non_working_dates", "working_dates", "source"],
      "properties": {
        "calendar_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
        "coverage_start": {"type": "string", "format": "date"},
        "coverage_end": {"type": "string", "format": "date"},
        "declared_complete": {"type": "boolean"},
        "weekend_weekdays": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 6}
        },
        "non_working_dates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "date"}},
        "working_dates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "date"}},
        "source": {"$ref": "#/$defs/source"}
      },
      "additionalProperties": false
    },
    "counted_days": {
      "type": "object",
      "required": ["method", "count", "day_kind", "include_operative_date"],
      "properties": {
        "method": {"const": "counted_days"},
        "count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "day_kind": {"enum": ["calendar", "working"]},
        "include_operative_date": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "anniversary": {
      "type": "object",
      "required": ["method", "unit", "count", "invalid_day_policy"],
      "properties": {
        "method": {"const": "anniversary"},
        "unit": {"enum": ["months", "years"]},
        "count": {"type": "integer", "minimum": 1, "maximum": 1200},
        "invalid_day_policy": {"enum": ["last_day_of_month", "block"]}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["rule_id", "name", "calculation", "non_working_expiry", "deadline_time", "source"],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 500},
        "calculation": {"oneOf": [{"$ref": "#/$defs/counted_days"}, {"$ref": "#/$defs/anniversary"}]},
        "non_working_expiry": {"enum": ["keep", "next_working_day", "previous_working_day"]},
        "calendar_id": {"type": "string"},
        "deadline_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"},
        "source": {"$ref": "#/$defs/source"}
      },
      "allOf": [
        {
          "if": {"anyOf": [
            {"properties": {"non_working_expiry": {"enum": ["next_working_day", "previous_working_day"]}}, "required": ["non_working_expiry"]},
            {"properties": {"calculation": {"properties": {"day_kind": {"const": "working"}}, "required": ["day_kind"]}}, "required": ["calculation"]}
          ]},
          "then": {"required": ["calendar_id"]}
        }
      ],
      "additionalProperties": false
    },
    "adjustment": {
      "type": "object",
      "required": ["adjustment_id", "type", "reason", "source"],
      "properties": {
        "adjustment_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
        "type": {"enum": ["add_days", "set_date"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "day_kind": {"enum": ["calendar", "working"]},
        "include_current_date": {"type": "boolean"},
        "calendar_id": {"type": "string"},
        "date": {"type": "string", "format": "date"},
        "source": {"$ref": "#/$defs/source"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "add_days"}}}, "then": {"required": ["count", "day_kind", "include_current_date"]}},
        {"if": {"properties": {"type": {"const": "set_date"}}}, "then": {"required": ["date"]}},
        {"if": {"properties": {"day_kind": {"const": "working"}}, "required": ["day_kind"]}, "then": {"required": ["calendar_id"]}}
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["event_id", "event_type", "operative_date", "operative_date_basis", "evidence_locator", "confirmed_by_human"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
        "event_type": {"type": "string", "minLength": 1, "maxLength": 200},
        "occurred_at": {"type": "string", "format": "date-time"},
        "operative_date": {"type": "string", "format": "date"},
        "operative_date_basis": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_locator": {"type": "string", "minLength": 1, "maxLength": 1000},
        "confirmed_by_human": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "deadline": {
      "type": "object",
      "required": ["deadline_id", "label", "timezone", "event", "rule", "adjustments", "exceptions", "blocking_questions"],
      "properties": {
        "deadline_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 500},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
        "event": {"$ref": "#/$defs/event"},
        "rule": {"$ref": "#/$defs/rule"},
        "adjustments": {"type": "array", "items": {"$ref": "#/$defs/adjustment"}},
        "exceptions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "blocking_questions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
