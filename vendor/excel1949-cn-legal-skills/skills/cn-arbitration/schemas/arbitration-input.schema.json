{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-arbitration/arbitration-input.schema.json",
  "title": "中国大陆仲裁工作台输入",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matter", "arbitration_agreement", "institution", "authorities", "claims", "jurisdiction_objections", "arbitrator_disclosures", "evidence", "schedule"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "matter": {
      "type": "object", "additionalProperties": false,
      "required": ["matter_id", "title", "as_of_date"],
      "properties": {
        "matter_id": {"type": "string", "minLength": 3},
        "title": {"type": "string", "minLength": 1},
        "as_of_date": {"type": "string", "format": "date"}
      }
    },
    "arbitration_agreement": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "exact_text", "party_ids", "institution_name_as_written", "seat_as_written", "scope_as_written", "review_status", "conflicts"],
      "properties": {
        "source_id": {"type": "string", "minLength": 3},
        "exact_text": {"type": "string", "minLength": 1},
        "party_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "institution_name_as_written": {"type": "string"},
        "seat_as_written": {"type": "string"},
        "scope_as_written": {"type": "string"},
        "review_status": {"enum": ["pending", "human_checked"]},
        "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "institution": {
      "type": "object", "additionalProperties": false,
      "required": ["institution_id", "name", "official_url", "source_version", "verified_on", "selection_status", "selection_basis"],
      "properties": {
        "institution_id": {"type": "string", "minLength": 3},
        "name": {"type": "string", "minLength": 1},
        "official_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_version": {"type": "string", "minLength": 1},
        "verified_on": {"type": "string", "format": "date"},
        "selection_status": {"enum": ["confirmed", "pending", "missing"]},
        "selection_basis": {"type": "string", "minLength": 1}
      }
    },
    "authorities": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/authority"}
    },
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "kind", "claimant_party_id", "respondent_party_ids", "request", "amount", "currency", "fact_ids", "evidence_ids", "authority_ids", "review_status"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 3},
          "kind": {"enum": ["claim", "counterclaim"]},
          "claimant_party_id": {"type": "string", "minLength": 1},
          "respondent_party_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "request": {"type": "string", "minLength": 1},
          "amount": {"type": ["number", "null"], "minimum": 0},
          "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
          "fact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "authority_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "review_status": {"enum": ["pending", "human_checked"]}
        }
      }
    },
    "jurisdiction_objections": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["objection_id", "raised_by", "issue", "basis", "evidence_ids", "authority_ids", "review_status"],
        "properties": {
          "objection_id": {"type": "string", "minLength": 3},
          "raised_by": {"type": "string", "minLength": 1},
          "issue": {"type": "string", "minLength": 1},
          "basis": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "authority_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "review_status": {"enum": ["pending", "human_checked"]}
        }
      }
    },
    "arbitrator_disclosures": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["disclosure_id", "arbitrator_ref", "disclosed_fact", "source_id", "assessment_status", "response_plan"],
        "properties": {
          "disclosure_id": {"type": "string", "minLength": 3},
          "arbitrator_ref": {"type": "string", "minLength": 1},
          "disclosed_fact": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "assessment_status": {"enum": ["pending", "human_assessed"]},
          "response_plan": {"type": "string"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "name", "source_id", "proof_purpose", "review_status"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 3},
          "name": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "proof_purpose": {"type": "string"},
          "review_status": {"enum": ["pending", "human_checked"]}
        }
      }
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "label", "date", "date_basis", "source_ref", "review_status"],
        "properties": {
          "event_id": {"type": "string", "minLength": 3},
          "label": {"type": "string", "minLength": 1},
          "date": {"type": ["string", "null"], "format": "date"},
          "date_basis": {"type": "string"},
          "source_ref": {"type": "string", "minLength": 1},
          "review_status": {"enum": ["pending", "human_checked"]}
        }
      }
    }
  },
  "$defs": {
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_id", "kind", "title", "official_url", "version", "verified_on", "effect_status", "applicability_status", "applies_basis"],
      "properties": {
        "authority_id": {"type": "string", "minLength": 3},
        "kind": {"enum": ["law", "arbitration_rule", "institution_notice"]},
        "title": {"type": "string", "minLength": 1},
        "official_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "version": {"type": "string", "minLength": 1},
        "verified_on": {"type": "string", "format": "date"},
        "effect_status": {"enum": ["effective", "unknown", "superseded"]},
        "applicability_status": {"enum": ["confirmed", "pending"]},
        "applies_basis": {"type": "string", "minLength": 1}
      }
    }
  }
}
