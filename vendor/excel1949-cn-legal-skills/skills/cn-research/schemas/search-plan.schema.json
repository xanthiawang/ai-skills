{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-research/search-plan.schema.json",
  "type": "object",
  "required": ["schema_version", "plan_id", "task", "branches"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "task": {"$ref": "research-task.schema.json"},
    "branches": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["branch_id", "question_id", "purpose", "source_classes", "legal_relationship_terms", "element_terms", "fact_terms", "procedure_terms", "outcome_terms", "variant_terms", "exclusion_terms", "query_strings", "execution_status"],
        "properties": {
          "branch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
          "question_id": {"type": "string", "minLength": 1},
          "purpose": {"enum": ["supportive", "adverse", "exception", "history", "scope"]},
          "source_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["official_law", "official_case", "official_regulatory", "local_corpus", "supplementary_lead", "web_discovery"]}},
          "legal_relationship_terms": {"$ref": "#/$defs/terms"},
          "element_terms": {"$ref": "#/$defs/terms"},
          "fact_terms": {"$ref": "#/$defs/terms"},
          "procedure_terms": {"$ref": "#/$defs/terms"},
          "outcome_terms": {"$ref": "#/$defs/terms"},
          "variant_terms": {"$ref": "#/$defs/terms"},
          "exclusion_terms": {"$ref": "#/$defs/terms"},
          "query_strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "execution_status": {"enum": ["not_run", "partial", "completed", "failed"]},
          "limitation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {"terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
  "additionalProperties": false
}
