{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-research/research-task.schema.json",
  "type": "object",
  "required": ["schema_version", "task_id", "matter_id", "cutoff_date", "research_questions", "source_types"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "matter_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "cutoff_date": {"type": "string", "format": "date"},
    "procedure": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "case_stage": {"type": "string"},
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question_id", "question"],
        "properties": {
          "question_id": {"type": "string"},
          "question": {"type": "string", "minLength": 1},
          "known_facts": {"type": "array", "items": {"type": "string"}},
          "missing_facts": {"type": "array", "items": {"type": "string"}},
          "search_both_sides": {"type": "boolean", "default": true}
        },
        "additionalProperties": false
      }
    },
    "source_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["legislation", "judicial_interpretation", "regulatory_document", "case", "guidance"]}
    },
    "preferred_tools": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

