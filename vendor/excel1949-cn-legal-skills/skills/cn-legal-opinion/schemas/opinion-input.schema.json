{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aioffice.example/schemas/cn-legal-opinion/opinion-input.schema.json",
  "title": "中国法律意见分析底稿输入",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matter_id", "mode", "jurisdiction", "as_of_date", "questions", "facts", "assumptions", "limitations", "authorities", "propositions", "conclusion_drafts"],
  "properties": {
    "schema_version": {"const": "1.0"}, "matter_id": {"$ref": "#/$defs/id"}, "mode": {"enum": ["production", "training_fixture"]}, "jurisdiction": {"type": "string", "minLength": 2, "maxLength": 200}, "as_of_date": {"type": "string", "format": "date"},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}, "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}}, "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}}, "limitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}}, "authorities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authority"}}, "propositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proposition"}}, "conclusion_drafts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conclusion"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
    "question": {"type": "object", "additionalProperties": false, "required": ["question_id", "text"], "properties": {"question_id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1, "maxLength": 3000}}},
    "span": {"type": "object", "additionalProperties": false, "required": ["source_id", "locator", "content_sha256"], "properties": {"source_id": {"$ref": "#/$defs/id"}, "locator": {"type": "string", "minLength": 1, "maxLength": 500}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["fact_id", "statement", "status", "source_spans"], "properties": {"fact_id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1, "maxLength": 6000}, "status": {"enum": ["confirmed", "conflicted", "unverified"]}, "source_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}}}},
    "assumption": {"type": "object", "additionalProperties": false, "required": ["assumption_id", "statement", "critical", "status"], "properties": {"assumption_id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1, "maxLength": 3000}, "critical": {"type": "boolean"}, "status": {"enum": ["confirmed", "unconfirmed"]}}},
    "limitation": {"type": "object", "additionalProperties": false, "required": ["limitation_id", "statement"], "properties": {"limitation_id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1, "maxLength": 3000}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["authority_id", "title", "issuing_body", "official_url", "verified_on", "effect_status", "verification_status", "locator", "text_sha256"], "properties": {"authority_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}, "issuing_body": {"type": "string", "minLength": 1}, "official_url": {"type": "string", "format": "uri", "pattern": "^https://"}, "verified_on": {"type": "string", "format": "date"}, "effect_status": {"enum": ["effective", "not_yet_effective", "expired", "unknown"]}, "verification_status": {"enum": ["verified_official", "pending", "conflict"]}, "locator": {"type": "string", "minLength": 1}, "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "proposition": {"type": "object", "additionalProperties": false, "required": ["proposition_id", "question_id", "stance", "statement", "fact_ids", "authority_ids"], "properties": {"proposition_id": {"$ref": "#/$defs/id"}, "question_id": {"$ref": "#/$defs/id"}, "stance": {"enum": ["supporting", "adverse", "neutral"]}, "statement": {"type": "string", "minLength": 1, "maxLength": 6000}, "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "authority_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "conclusion": {"type": "object", "additionalProperties": false, "required": ["conclusion_id", "question_id", "statement", "fact_ids", "authority_ids", "dependency_assumption_ids", "conditions"], "properties": {"conclusion_id": {"$ref": "#/$defs/id"}, "question_id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1, "maxLength": 6000}, "fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "authority_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "dependency_assumption_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "conditions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}}}}
  }
}
